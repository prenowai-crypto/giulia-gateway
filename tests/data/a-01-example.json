[
  {
    "id": "A-001",
    "category": "booking-basic",
    "description": "Create + verify + cleanup standard evening booking",
    "setup": [],
    "steps": [
      {
        "action": "check_availability",
        "params": { "data": "$NEXT_WED", "ora": "21:00:00", "persone": 3 },
        "assert": [
          { "path": "success", "equals": true },
          { "path": "reason", "equals": "slot_available" }
        ]
      },
      {
        "action": "create_reservation",
        "params": {
          "nome": "Test User A001",
          "persone": 3,
          "data": "$NEXT_WED",
          "ora": "21:00:00",
          "note": ""
        },
        "assert": [
          { "path": "success", "equals": true },
          { "path": "eventId", "exists": true }
        ],
        "save": { "eventId": "eventId" }
      },
      {
        "action": "find_reservation",
        "params": { "nome": "Test User A001", "data": "$NEXT_WED", "sheet": "Prenotazioni" },
        "assert": [
          { "path": "success", "equals": true }
        ]
      }
    ],
    "cleanup": [
      { "action": "cancel_reservation", "params": { "eventId": "$eventId" } }
    ]
  },
  {
    "id": "A-002",
    "category": "availability-edge",
    "description": "Closed day (Monday) must return day_closed",
    "setup": [],
    "steps": [
      {
        "action": "check_availability",
        "params": { "data": "$NEXT_MONDAY", "ora": "21:00:00", "persone": 2 },
        "assert": [
          { "path": "success", "equals": false },
          { "path": "reason", "equals": "day_closed" }
        ]
      }
    ],
    "cleanup": []
  }
]
